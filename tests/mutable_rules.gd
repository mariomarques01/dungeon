extends SceneTree
const Rules = preload('res://scripts/mutable_rules.gd')
var count = 0
func check(ok: bool, label: String) -> void:
 if not ok:push_error('FAIL: '+label);quit(1);assert(ok,label)
 count += 1;print('PASS: '+label)
func _initialize() -> void:
 var r = Rules.new()
 check(r.state.hands[0].size() == 4 and r.state.queues[0].size() == 6,'10 cards, four in hand')
 var before = r.state.duplicate(true)
 check(not r.play(0,0,350,350).is_empty() and r.state == before,'invalid half does not spend energy or rotate hand')
 check(not r.play(0,0,NAN,550).is_empty(),'reject non-finite coordinates')
 check(not r.play(0,0,30,550).is_empty(),'reject dungeon walls outside floor')
 check(r.play(0,0,250,550).is_empty(),'legal golem summon')
 check(r.state.energy[0] == 3 and r.state.hands[0][0] == 'skeleton' and r.state.units.size() == 1,'summon charges once and rotates queue')
 check(r.play(0,0,300,550).is_empty(),'second legal summon')
 check(not r.play(0,1,350,550).is_empty(),'insufficient energy blocked')
 r.reset();r.play(0,3,300,550)
 check(r.state.units.size() == 2 and r.state.units[0].id == 'skeleton','portal summons two units')
 r.reset();r.spawn(0,'golem',350,510);r.spawn(1,'orc',350,470)
 for i in range(20):r.step(0.1)
 check(r.state.units[0].hp < 640 and r.state.units[1].hp < 530,'real time creatures damage each other')
 r.reset();r.spawn(0,'goblin',350,270)
 for i in range(15):r.step(0.1)
 check(r.state.cores[1] < 2400,'units attack enemy core')
 r.reset();r.spawn(1,'orc',350,400);r.ability(0,350,400)
 check(r.state.units[0].hp == 350 and r.state.cooldowns[0] == 22,'summoner ability damages rival and starts cooldown')
 check(not r.ability(0,350,400).is_empty() and r.state.units[0].hp == 350,'cooldown prevents replay')
 r.reset()
 for i in range(301):r.step(0.1)
 check(r.state.phase == 1 and r.state.energy[0] == 10,'30 second transformation and energy cap')
 for i in range(300):r.step(0.1)
 check(r.state.phase == 2,'second transformation activates trap')
 r.spawn(0,'golem',470,600)
 var hp = r.state.units[0].hp;r.step(0.1)
 check(r.state.units[0].hp < hp,'trap damages units')
 r.reset();r.state.time = 0.05;r.state.cores[1] = 1500;r.step(0.1)
 check(r.state.winner == 0,'time limit resolves surviving core health')
 var final_state = r.state.duplicate(true);r.step(0.1)
 check(r.state == final_state and not r.play(0,0,300,550).is_empty(),'finished game freezes and rejects plays')
 r.reset()
 for i in range(2401):r.step(0.1,true)
 check(r.state.winner != -2 and r.state.casts[1] > 0,'full practice game finishes with AI playing')
 print('MUTABLE_RULES_OK ',count);quit()
